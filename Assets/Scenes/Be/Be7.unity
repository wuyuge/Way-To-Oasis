--- !u!1001 &1602996270
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2464871338798718914, guid: 770bfc08bacbc964484e69a2f0568c05, type: 3}
      propertyPath: m_text
      value: "<size=120>\u7FA4\u4F53\u6548\u5E94</size>\n\n\u4E0D\u77E5\u51FA\u4E8E\u4EC0\u4E48\u60F3\u6CD5\uFF0C\u4F60\u9009\u62E9\u4E86\u8FD9\u6837\u4E00\u79CD\u5904\u7406\u65B9\u5F0F\u3002\r\n\u7ED3\u679C\u51FA\u4E4E\u610F\u6599\u7684\u795E\u5947\u3002\r\n\u5728\u4E00\u4E2A\u9700\u8981\u6709\u4EBA\u8BF4\u4E9B\u4EC0\u4E48\u7684\u65F6\u5019\uFF0C\u961F\u4F0D\u53CD\u800C\u7B2C\u4E00\u6B21\u5B89\u9759\u4E86\u4E0B\u6765\u3002\r\n\u6240\u6709\u7684\u5FF5\u5934\u90FD\u88AB\u8FD9\u79CD\u4F1F\u5927\u800C\u7EDF\u4E00\u7684\u5949\u732E\u611F\u4E0E\u56E2\u7ED3\u62B9\u9664\u3002\u4E00\u65F6\u4E4B\u95F4\uFF0C\u6CA1\u6709\u4EBA\u63D0\u51FA\u53CD\u5BF9\u3002\r\n{Laiwen}\u826F\u4E45\u8FC7\u540E\uFF0C\u6709\u4EBA\u63D0\u51FA\u4E86\u610F\u89C1\u3002\r\n{Aimi}
        {Bo} {Luo}\u201C\u2026\u2026\u201D\r\n\u6700\u540E\u7684\u8A00\u8BED\u90FD\u5F52\u4E8E\u4E86\u5BC2\u9759\u3002\r\n\u6240\u6709\u4EBA\u7A81\u7136\u610F\u8BC6\u5230\u4F60\u63D0\u51FA\u7684\u5EFA\u8BAE\u6216\u8BB8\u662F\u8DDD\u79BB\u89E3\u8131\u6700\u8FD1\u7684\u8DEF\u5F84\u3002\r\n\u6CA1\u6709\u4EBA\u613F\u610F\u5728\u6CE8\u5B9A\u7EDD\u671B\u7684\u4E16\u754C\u4E2D\u91CD\u590D\u5F98\u5F8A\u3002\r\n\u4E00\u79CD\u5FF5\u5934\u6307\u5F15\u7740\u4F60\u4EEC\u6700\u7EC8\u9020\u6210\u4E86\u8FD9\u4E00\u7FA4\u4F53\u6027\u7684\u884C\u4E3A\u3002\r\n\u4F60\u7684\u51B3\u5B9A\u7EC8\u7ED3\u4E86\u8FD9\u4E00\u5207\uFF0C\u53C8\u5C06\u5BFC\u5411\u65B0\u7684\u5F00\u59CB\u3002\n\u665A\u5B89,{PlayerName}\u3002"
      objectReference: {fileID: 0}
