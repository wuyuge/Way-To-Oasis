  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u6CA1\u4E8B\u5427\uFF0C\u25A0\u25A0\uFF1F\u522B\u592A\u96BE\u8FC7\u4E86\u3002"
  - p
  - "\u55EF\u3002\u6211\u5F88\u597D\uFF0C\u8C22\u8C22\u4F60\u7684\u5173\u5FC3\u3002"
  - c
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026"
  - "\u963F\u66FC\u5FB7\uFF1A\u6240\u4EE5\uFF0C\u961F\u957F\u5DF2\u7ECF\u53BB\u4E16\u4E86\u5417\uFF1F"
  - p
  - "\u662F\u7684\u3002\u8FD9\u4EF6\u4E8B\u60C5\u592A\u7A81\u7136\u4E86\uFF0C\u4F46\u6211\u5FC5\u987B\u63A5\u66FF\u4ED6\u7684\u8D23\u4EFB\uFF0C\u4ECE\u73B0\u5728\u5F00\u59CB\u4E3A\u961F\u4F0D\u8D1F\u8D23\u3002"
  - c
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026\u6211\u4EEC\u8C01\u90FD\u4E0D\u60F3\u770B\u5230\u8FD9\u79CD\u4E8B\u53D1\u751F\u3002\u6211\u4E0D\u60F3\u7ED9\u4F60\u5E26\u6765\u4EFB\u4F55\u538B\u529B\uFF0C\u4F46\u662F\u6211\u4E0D\u77E5\u9053\u4E9A\u6469\u65AF\u961F\u957F\u7684\u6B7B\u4F1A\u5BF9\u6211\u4EEC\u9020\u6210\u591A\u5927\u7684\u5F71\u54CD\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u5927\u5BB6\u90FD\u5728\u4E3A\u73B0\u72B6\u62C5\u5FE7\uFF0C\u6CA1\u6709\u4EBA\u613F\u610F\u9009\u62E9\u846C\u8EAB\u5728\u8FD9\u7247\u8352\u6F20\u3002"
  - p
  - "\u786E\u5B9E\u5982\u6B64\uFF0C\u4F46\u662F\u6211\u4EEC\u663E\u7136\u4E0D\u80FD\u3001\u4E5F\u65E0\u6CD5\u9690\u7792\u8FD9\u4EF6\u4E8B\uFF0C\u65E9\u4E00\u70B9\u544A\u77E5\u6240\u6709\u4EBA\u4E5F\u53EF\u4EE5\u5C3D\u53EF\u80FD\u51CF\u5C11\u60B2\u4F24\u6050\u614C\u7684\u8513\u5EF6\u3002"
  - c
  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u662F\u5BF9\u7684\uFF0C\u6211\u60F3\u4F60\u4E00\u5B9A\u4F1A\u662F\u4E00\u4E2A\u79F0\u804C\u7684\u961F\u957F\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u65E2\u7136\u4F60\u5DF2\u7ECF\u51B3\u5B9A\u4E86\uFF0C\u90A3\u5C31\u5FEB\u53BB\u5427\u3002\u2026\u2026\u62B1\u6B49\uFF0C\u6211\u60F3\u81EA\u5DF1\u7F13\u4E00\u7F13\u3002"
  - closecharabar
  - p
  - "\u963F\u66FC\u5FB7\u5E0C\u671B\u6211\u628A\u961F\u957F\u53BB\u4E16\u8FD9\u4EF6\u4E8B\u544A\u8BC9\u5176\u4ED6\u961F\u5458\u3002"
  - "\u5728\u6B64\u4E4B\u524D\uFF0C\u6211\u9700\u8981\u6574\u7406\u4E00\u4E0B\u601D\u8DEF\u3002"
  - choice
