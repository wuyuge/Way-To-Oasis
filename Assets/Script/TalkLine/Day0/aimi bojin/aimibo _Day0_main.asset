  TxtLine:
  - ${ShowCharacterTalkBox}
  - ${LockSwitchStage}
  - ->p
  - "\u961F\u957F\u6B7B\u4E86\u3002"
  - ->c
  - "\u827E\u7C73\u8389\uFF1A\u2026\u55EF\uFF0C\u6211\u77E5\u9053\u4E86\u3002"
  - "\u535A\u91D1\u68EE\uFF1A(\u70B9\u70B9\u5934)"
  - "\u827E\u7C73\u8389\uFF1A\u65E2\u7136\u662F\u4F60\u6765\u901A\u77E5\u8FD9\u4EF6\u4E8B\uFF0C\u770B\u6765\u4F60\u4E4B\u540E\u5C31\u662F\u65B0\u961F\u957F\u4E86\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u4E4B\u540E\u7684\u4FA6\u67E5\u7ED3\u679C\u6211\u4EEC\u4F1A\u76F4\u63A5\u5411\u4F60\u6C47\u62A5\u3002"
  - ->p
  - "\u5173\u4E8E\u8FD9\u4EF6\u4E8B\uFF0C\u4F60\u4EEC\u6CA1\u6709\u4EC0\u4E48\u60F3\u8BF4\u7684\u5417\uFF1F"
  - ->c
  - "\u827E\u7C73\u8389\uFF1A\u6CA1\u6709\u65F6\u95F4\u60B2\u4F24\u4E86\uFF0C\u518D\u8FD9\u6837\u4E0B\u53BB\u6211\u4EEC\u5F88\u5FEB\u5C31\u4F1A\u6B65\u4E86\u4ED6\u7684\u540E\u5C18\u3002"
  - ->p
  - "\u7684\u786E\u5982\u6B64\uFF0C\u90A3\u5C31\u5148\u6C47\u62A5\u60C5\u51B5\u5427\u3002"
  - ->c
  - "\u827E\u7C73\u8389\uFF1A\u5F88\u9057\u61BE\uFF0C\u4ECA\u5929\u4F9D\u65E7\u65E0\u6CD5\u63A5\u6536\u5230\u4EFB\u4F55\u4FE1\u53F7\u3002\u6211\u4EEC\u5728\u6301\u7EED\u4E0D\u65AD\u5730\u53D1\u51FA\u8BAF\u606F\uFF0C\u73B0\u5728\u53EA\u80FD\u7948\u7977\u6551\u63F4\u961F\u6216\u662F\u4EFB\u4F55\u5176\u4ED6\u5546\u961F\u53EF\u4EE5\u63A5\u6536\u5230\u5E76\u63D0\u4F9B\u5E2E\u52A9\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u81F3\u4E8E\u5176\u4ED6\u65B9\u9762\u2026"
  - "\u535A\u91D1\u68EE\uFF1A\u5468\u56F4\u6CA1\u6709\u4EFB\u4F55\u751F\u7269\u6D3B\u52A8\u7684\u75D5\u8FF9\uFF0C\u8FD9\u91CC\u662F\u5F7B\u5E95\u7684\u8352\u6F20\u3002"
  - ->p
  - "\u6211\u77E5\u9053\u4E86\u3002"
  - "\u8F9B\u82E6\u4E86\u4E24\u4F4D\uFF0C\u8FD9\u5DF2\u7ECF\u662F\u6211\u4EEC\u5728\u5BFB\u627E\u51FA\u8DEF\u7684\u540C\u65F6\u80FD\u505A\u7684\u4E3A\u6570\u4E0D\u591A\u7684\u52AA\u529B\u4E86\u3002"
  - "\u987A\u5E26\u4E00\u63D0\uFF0C\u6211\u60F3\u95EE\u95EE\u4F60\u4EEC\u5BF9\u5982\u4F55\u5904\u7406\u8001\u961F\u957F\u9057\u4F53\u8FD9\u4EF6\u4E8B\u7684\u610F\u89C1\u3002"
  - ->c
  - "\u827E\u7C73\u8389\uFF1A\u968F\u4FBF\u4F60\uFF0C\u600E\u4E48\u5904\u7406\u90FD\u884C\u3002"
  - "\u535A\u91D1\u68EE\uFF1A\u6211\u6CA1\u610F\u89C1\u3002"
