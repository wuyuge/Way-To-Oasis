    showCg: 0
    cgNum: 0
    minigameType: 0
    uncomfortType: 0
    audioEffect: 0
  - cn: "\u547C\u2026\u2026\uFF0C\u55EF\uFF0C\u2026\u6211\u76F8\u4FE1\u4F60\u3002"
    en: Hah... yes. I believe you.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
