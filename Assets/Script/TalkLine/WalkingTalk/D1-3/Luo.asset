  TxtLine:
  - "\u6D1B\u5C14\u574E\uFF1A\u2026\u65E9\u77E5\u9053\u591A\u5E26\u51E0\u526F\u5907\u7528\u7684\u4E86\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u9633\u5149\u597D\u523A\u773C\uFF0C\u660E\u660E\u6CA1\u6709\u592A\u9633\u6765\u7740\u2026\u6709\u70B9\u770B\u4E0D\u6E05\u8DEF\u4E86\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u597D\u60F3\u56DE\u5BB6\u554A\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u2026\u6211\u518D\u4E5F\u4E0D\u62B1\u6028\u4FEE\u91CE\u5730\u8F66\u65E0\u804A\u4E86\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u811A\u597D\u75DB\uFF0C\u611F\u89C9\u8FD9\u51E0\u5929\u8D70\u5B8C\u4E86\u6211\u4E00\u5E74\u7684\u8DEF\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u5982\u679C\u4E0B\u6B21\u8FD8\u6709\u59D4\u6258\u7684\u8BDD\u2026\u2026\u554A\u554A\u554A\u8FD9\u6B21\u90FD\u4E0D\u4E00\u5B9A\u80FD\u51FA\u53BB\u5462\uFF0C\u522B\u4E71\u60F3\u4E86\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u518D\u575A\u6301\u51E0\u6B65\u5C31\u80FD\u4F11\u606F\u4E86\uFF0C\u547C\u2026\u2026"
