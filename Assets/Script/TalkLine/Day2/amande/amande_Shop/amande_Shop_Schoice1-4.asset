  - "\u963F\u66FC\u5FB7\uFF1A\u8FD9\u6837\u554A\u3002@{3}"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F46\u8FD9\u4E00\u5207\u90FD\u6CA1\u6709\u610F\u4E49\u4E86\u3002@{7}"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u6216\u8BB8\u4F1A\u7591\u60D1\u6211\u4E3A\u4F55\u65E0\u6CD5\u63A5\u53D7\u8FD9\u4E00\u5207\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u8FD9\u4E0D\u4E00\u6837\uFF0C{PlayerName}\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u6BD4\u6211\u60F3\u8C61\u5F97\u66F4\u575A\u51B3\u3002\u800C\u6211\u4E0D\u77E5\u9053\u81EA\u5DF1\u662F\u4E0D\u662F\u505A\u4E86\u4E00\u4E2A\u9519\u8BEF\u7684\u51B3\u5B9A\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u66FE\u7ECF\u60F3\u8981\u4FDD\u5168\u6240\u6709\u4EBA\uFF0C\u4FDD\u5168\u66F4\u591A\u4EBA\u2026\u2026\u81F3\u5C11\u4FDD\u5168\u81EA\u5DF1\u6D3B\u4E0B\u53BB\u3002\u5230\u5934\u6765\u5374\u53D1\u73B0\u65E0\u8BBA\u6211\u9009\u62E9\u4E86\u4EC0\u4E48\uFF0C\u90FD\u96BE\u9003\u6B7B\u4EA1\u7684\u547D\u8FD0\u3002"
  - "    \u963F\u66FC\u5FB7\uFF1A\u6211\u6240\u505A\u7684\u4E00\u5207\u52AA\u529B\u4E5F\u8BB8\u90FD\u53EA\u662F\u5F92\u52B3\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u65E2\u7136\u6211\u65E0\u529B\u6539\u53D8\u2026\u2026\u90A3\u6211\u53EA\u80FD\u9003\u79BB\u8FD9\u4E2A\u5730\u65B9\uFF0C\u4E0D\u7BA1\u7528\u4EC0\u4E48\u529E\u6CD5\u3002"
