  - cn: "\u201C\u6211\u6CA1\u60F3\u5230\u4F60\u4F1A\u8FD9\u4E48\u505A\u3002\u201D\u963F\u66FC\u5FB7\u6700\u7EC8\u5F00\u53E3\u8BF4\u9053\u3002"
