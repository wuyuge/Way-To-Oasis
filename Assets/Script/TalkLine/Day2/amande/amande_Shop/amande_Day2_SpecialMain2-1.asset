  TxtLine:
  - ${ShowCharacterTalkBox}
  - ${LockSwitchStage}
  - ->c
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026\u6211\u65E0\u6CD5\u63A5\u53D7\u4F60\u7684\u6240\u4F5C\u6240\u4E3A\u3002@{7}"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u90A3\u65F6\u76F8\u4FE1\u4E86\u4F60\uFF0C\u7B54\u5E94\u4E86\u4F60\u7684\u8BF7\u6C42\uFF0C\u6CA1\u6709\u5728\u6240\u6709\u4EBA\u9762\u524D\u63ED\u9732\u4F60\u7684\u771F\u9762\u76EE\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026\u76F4\u5230\u73B0\u5728\u6211\u624D\u610F\u8BC6\u5230\u6211\u505A\u51FA\u4E86\u4E00\u4E2A\u591A\u4E48\u9519\u8BEF\u7684\u51B3\u5B9A\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u66FE\u7ECF\u60F3\u8981\u4FDD\u5168\u6240\u6709\u4EBA\uFF0C\u4FDD\u5168\u66F4\u591A\u4EBA\u2026\u2026\u81F3\u5C11\u4FDD\u5168\u81EA\u5DF1\u6D3B\u4E0B\u53BB\u3002\u5230\u5934\u6765\u5374\u53D1\u73B0\u65E0\u8BBA\u6211\u9009\u62E9\u4E86\u4EC0\u4E48\uFF0C\u90FD\u96BE\u9003\u6B7B\u4EA1\u7684\u547D\u8FD0\u3002@{3}"
  - "\u963F\u66FC\u5FB7\uFF1A\u5728\u4F60\u773C\u91CC\uFF0C\u6211\u4EEC\u8FD9\u4E9B\u4EBA\u90FD\u662F\u4EC0\u4E48\u2026\u2026@{7}"
  - "\u963F\u66FC\u5FB7\uFF1A\u597D\u7528\u7684\u5DE5\u5177\uFF0C\u8FD8\u662F\u53EF\u4F9B\u4EA4\u6362\u7684\u540E\u5907\u8D27\u7269\uFF1F"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u53EF\u4EE5\u4E3A\u4E86\u751F\u5B58\u727A\u7272\u4E00\u5207\uFF0C\u4E0D\u662F\u5417\uFF1F"
  - "\u963F\u66FC\u5FB7\uFF1A\u6D3B\u4E0B\u53BB\u7684\u53EF\u4EE5\u6CA1\u6709\u4EFB\u4F55\u4EBA\uFF0C\u4F46\u4E00\u5B9A\u6709\u4F60\u81EA\u5DF1\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026@{3}"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F60\u6CA1\u6709\u9519\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u77E5\u9053\u8FD9\u4E0D\u662F\u4F60\u7684\u672C\u610F\uFF0C\u6CA1\u6709\u4EBA\u5E0C\u671B\u8FD9\u6837\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u4F46\u6211\u53EA\u662F\u96BE\u8FC7\uFF0C\u96BE\u8FC7\u5F88\u591A\u4E8B\u60C5\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u603B\u6709\u4E00\u5929\uFF0C\u6211\u4EEC\u90FD\u4F1A\u4E3A\u81EA\u5DF1\u7684\u9009\u62E9\u4ED8\u51FA\u4EE3\u4EF7\u3002@{4}"
