    audioEffect: 0
  - cn: "\u201C\u6211\u4E3A\u6211\u7684\u9009\u62E9\u800C\u611F\u5230\u540E\u6094\u3002\u201D\u5979\u7684\u58F0\u97F3\u8F7B\u5F97\u4F60\u51E0\u4E4E\u6CA1\u6709\u542C\u6E05\u3002"
    en: '"I regret my choice." Her voice is so soft that you almost do not hear it.'
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 1
    codes: 
    onlyCode: 0
