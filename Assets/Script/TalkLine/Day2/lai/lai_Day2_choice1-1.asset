  - cn: "\u5509\uFF0C\u751F\u547D\u4EF7\u503C\u5982\u4F55\u8861\u91CF\u8FD9\u79CD\u8001\u751F\u5E38\u8C08\u7684\u95EE\u9898\uFF0C\u653E\u5728\u8FD9\u91CC\u8FD8\u771F\u662F\u4E0D\u5408\u65F6\u5B9C\u3002"
    en: 'Sigh. The old question of how to measure the value of life is really out
      of place here. '
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
    speaker: 4
