  TxtLine:
  - ->c
  - "\u827E\u7C73\u8389\uFF1A\u6211\u8FD8\u6D3B\u7740\uFF0C\u4ED6\u628A\u98DF\u7269\u7559\u7ED9\u6211\u7136\u540E\u627E\u4F60\u7B97\u8D26\u53BB\u4E86\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u65E2\u7136\u4F60\u6765\u627E\u6211\uFF0C\u8BF4\u660E\u4ED6\u5931\u8D25\u4E86\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u6280\u4E0D\u5982\u4EBA\uFF0C\u6CA1\u4EC0\u4E48\u597D\u8BF4\u7684\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u53EA\u53EF\u60DC\u770B\u4F60\u4F3C\u4E4E\u6CA1\u53D7\u4EC0\u4E48\u4F24\uFF0C\u6211\u4F1A\u8BB0\u5F97\u72E0\u72E0\u5632\u7B11\u4ED6\u7684\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u4F46\u8FD9\u4E0D\u4EE3\u8868\u6211\u8D5E\u540C\u4F60\u7684\u505A\u6CD5\uFF0C\u8822\u8D27\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u727A\u7272\u53EF\u9760\u7684\u961F\u53CB\u5BF9\u4F60\u6709\u4EC0\u4E48\u597D\u5904\uFF0C\u8FD8\u662F\u8BF4\u4F60\u8282\u7701\u98DF\u7269\u7684\u65B9\u5F0F\u662F\u968F\u4F60\u559C\u6B22\u6311\u4E00\u4E2A\u4EBA\u53BB\u6B7B\uFF1F"
  - "\u827E\u7C73\u8389\uFF1A\u4F60\u6709\u5F88\u591A\u66F4\u4F18\u7684\u9009\u62E9\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u6211\u4F1A\u7EE7\u7EED\u6211\u7684\u5DE5\u4F5C\uFF0C\u4E0D\u4E3A\u4E86\u522B\u7684\uFF0C\u53EA\u662F\u8FD9\u6837\u6D3B\u4E0B\u53BB\u7684\u6982\u7387\u66F4\u9AD8\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u81F3\u4E8E\u522B\u7684\uFF0C\u4F60\u522B\u6307\u671B\u4E86\uFF0C\u79BB\u6211\u8FDC\u70B9\u3002"
