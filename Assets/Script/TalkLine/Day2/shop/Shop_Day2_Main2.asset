    cgNum: 0
    minigameType: 0
  - cn: "\u4F60\u5230\u5E95\u60F3\u8BF4\u4EC0\u4E48\uFF1F"
    en: What exactly are you trying to say?
    cnHaveBranch: 0
    cnBranch: []
