  TxtLine:
  - ->c
  - "\u83B1\u6587\uFF1A\u8FD8\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
  - "\u83B1\u6587\uFF1A\u5982\u679C\u662F\u60F3\u804A\u5929\u6211\u5F53\u7136\u613F\u610F\u5949\u966A\uFF0C\u8981\u662F\u4F60\u60F3\u542C\u6211\u6C47\u62A5\u5DE5\u4F5C\u4E4B\u7C7B\u5C31\u6709\u70B9\u96BE\u529E\u4E86\u2026\u2026"
  - "\u83B1\u6587\uFF1A\u6BD5\u7ADF\u6211\u8D1F\u8D23\u7684\u662F\u7269\u8D44\u91C7\u8D2D\u548C\u534F\u8C03\u5DE5\u4F5C\u2026\u73B0\u5728\u7684\u72B6\u51B5\u7528\u4E0D\u4E0A\u91C7\u8D2D\uFF0C\u4E5F\u6CA1\u6709\u7269\u8D44\u3002"
  - "\u83B1\u6587\uFF1A\u81F3\u4E8E\u534F\u8C03\u5DE5\u4F5C\u2026\u8FD9\u513F\u770B\u7740\u4E5F\u4E0D\u50CF\u662F\u6709\u4EC0\u4E48\u5176\u4ED6\u5546\u961F\u7684\u6837\u5B50\u3002"
  - "\u83B1\u6587\uFF1A\u6211\u90FD\u6E05\u95F2\u5F97\u5F00\u59CB\u6570\u6C99\u5B50\u4E86\u3002"
  - "\u83B1\u6587\uFF1A\u2026\u961F\u957F\u60A8\u53EF\u522B\u89C9\u5F97\u6211\u6CA1\u7528\u8981\u628A\u6211\u4E22\u4E0B\u554A\uFF0C\u600E\u4E48\u8BF4\u6211\u4EEC\u4E5F\u6709\u5341\u51E0\u5E74\u7684\u60C5\u8C0A\u5728\u3002@{6}"
  - "\u83B1\u6587\uFF1A\u6240\u4EE5\u8981\u4E0D\u6765\u548C\u6211\u804A\u804A\uFF1F@{3}"
  - ${Choice}
  data:
  - cn: "\u8FD8\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
    en: Is there anything else?
    cnHaveBranch: 0
    cnBranch: []
