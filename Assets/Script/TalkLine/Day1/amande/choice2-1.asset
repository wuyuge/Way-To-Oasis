    showCg: 0
    cgNum: 0
    minigameType: 0
    uncomfortType: 0
  - cn: "\u55EF\u2026\u2026\u4ECE\u8C01\u5F00\u59CB\u6BD4\u8F83\u597D\u5462\uFF1F\u6D1B\u5C14\u574E\u600E\u4E48\u6837\uFF1F\u5E74\u8F7B\u7684\u65B0\u4EBA\u603B\u662F\u503C\u5F97\u4E00\u4E9B\u4F18\u5F85\u3002"
    en: Hmm... Who should I start with? How about Lorquin? Young newcomers always
      deserve a little kindness.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
