    cgNum: 0
    minigameType: 0
    uncomfortType: 0
  - cn: "\u6211\u89C9\u5F97\u4ED6\u662F\u4E2A\u5F88\u6709\u5929\u8D4B\u7684\u5B69\u5B50\uFF0C\u800C\u4E14\u6CA1\u6709\u4EE5\u5F80\u90A3\u4E9B\u673A\u68B0\u4FEE\u7406\u5E08\u7684\u81ED\u6BDB\u75C5\u3002"
    en: I think he is a very talented kid, and he does not have the usual bad habits
      of mechanical repair technicians.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
