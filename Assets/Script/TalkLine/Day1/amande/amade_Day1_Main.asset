  - ->c
  - "\u963F\u66FC\u5FB7\uFF1A\u55E8\uFF0C\u4F60\u6765\u4E86\u3002@{1}"
  - "\u963F\u66FC\u5FB7\uFF1A\u7B2C\u4E00\u5929\u5F53\u961F\u957F\u7684\u611F\u89C9\u8FD8\u597D\u5417\uFF1F@{5}"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u4E0D\u5E0C\u671B\u7ED9\u4F60\u592A\u5927\u7684\u538B\u529B\uFF0C\u4F46\u4F60\u53EF\u80FD\u786E\u5B9E\u662F\u6211\u4EEC\u4E4B\u4E2D\u6700\u9002\u5408\u6210\u4E3A\u9886\u8896\u7684\u4EBA\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u5F88\u9AD8\u5174\u4F60\u613F\u610F\u544A\u8BC9\u5927\u5BB6\u90A3\u4EF6\u4E8B\uFF0C\u800C\u4E0D\u662F\u628A\u6240\u6709\u4EBA\u90FD\u7792\u5728\u9F13\u91CC\u3002"
  - ->p
  - "\u4F60\u662F\u6307\u6211\u4EEC\u7684\u98DF\u7269\u4E0D\u591A\u4E86\uFF1F"
  - ->c
  - "\u963F\u66FC\u5FB7\uFF1A\u6CA1\u9519\uFF0C\u867D\u7136\u5F88\u96BE\u63A5\u53D7\uFF0C\u4F46\u603B\u597D\u8FC7\u4E00\u65E0\u6240\u77E5\u5730\u6B7B\u3002@{3}"
  - "\u963F\u66FC\u5FB7\uFF1A\u8FD9\u600E\u4E48\u4E0D\u7B97\u4E00\u79CD\u6B3A\u9A97\u5462\uFF0C\u8BA9\u6211\u4EEC\u59CB\u7EC8\u4E0D\u5FC5\u4E3A\u8FD9\u6837\u7684\u75DB\u82E6\u6240\u70E6\u607C\u3002"
  - ->p
  - "\u4E9A\u6469\u65AF\u6709\u81EA\u5DF1\u7684\u8003\u8651\uFF0C\u6211\u4E5F\u662F\u3002"
  - ->c
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026\u4F60\u4EEC\u90FD\u662F\u5BF9\u7684\u3002@{7}"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u53EA\u662F\u5728\u60F3\u2026\u2026\u6211\u4EEC\u771F\u7684\u80FD\u5728\u98DF\u7269\u8017\u5C3D\u4E4B\u524D\u628A\u6240\u6709\u4EBA\u90FD\u6D3B\u7740\u5E26\u51FA\u53BB\u5417\uFF1F"
  - ${Choice}
