    showCg: 0
    cgNum: 0
    minigameType: 0
  - cn: "\u8FD8\u597D\u2026\u8FD9\u662F\u6211\u7684\u5DE5\u4F5C\u561B\u3002"
    en: It is fine... This is my job, after all.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
