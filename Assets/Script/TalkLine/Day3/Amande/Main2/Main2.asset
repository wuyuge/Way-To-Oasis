  TxtLine:
  - c
  - "\u963F\u66FC\u5FB7\uFF1A\u2026\u2026\u8FD9\u771F\u662F\u4E00\u573A\u5669\u68A6\uFF0C\u5BF9\u5427\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u6211\u90FD\u6709\u4E9B\u5206\u4E0D\u6E05\u8FD9\u662F\u771F\u5B9E\u53D1\u751F\u7684\u8FD8\u662F\u5E7B\u60F3\u4E86\u3002"
  - "\u963F\u66FC\u5FB7\uFF1A\u771F\u7684\u6709\u4EBA\u6B7B\u53BB\u4E86\u5417\uFF1F\u8FD8\u662F\u6211\u7684\u6050\u60E7\u8BA9\u6211\u9884\u89C1\u8FD9\u4E2A\u7ED3\u679C\uFF1F"
