  - cn: "\u552F\u4E00\u7684\u597D\u6D88\u606F\u662F\uFF0C\u65E0\u8BBA\u6211\u4EEC\u5F97\u51FA\u4E86\u4EC0\u4E48\u7ED3\u8BBA\u90FD\u6CA1\u6709\u5FC5\u8981\u7ACB\u523B\u5206\u4EAB\u3002"
    en: "The only good news is that whatever conclusions we reached, we don\u2019t
      have to disclose them right away."
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
