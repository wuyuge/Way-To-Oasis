    minigameType: 0
    uncomfortType: 0
  - cn: "\u542C\u8D77\u6765\u771F\u53EF\u60B2\u3002"
    en: That sounds truly sad.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
