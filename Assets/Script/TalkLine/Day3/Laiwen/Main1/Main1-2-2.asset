    cgNum: 0
    minigameType: 0
    uncomfortType: 0
  - cn: "\u73B0\u5728\u6211\u4EEC\u624B\u5934\u4E0A\u6700\u5BBD\u88D5\u7684\u662F\u65F6\u95F4\uFF0C\u6700\u7A00\u7F3A\u7684\u4E5F\u662F\u3002"
    en: "We have more time than anything else, yet it\u2019s the one thing we\u2019re
      running out of the fastest."
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
    speaker: 4
