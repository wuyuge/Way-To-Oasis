    cgNum: 0
    minigameType: 0
    uncomfortType: 0
  - cn: "\u4E0D\u7528\u5411\u6211\u89E3\u91CA\u4EC0\u4E48\u961F\u957F\uFF0C\u6211\u5927\u6982\u7406\u89E3\u4E00\u4E9B\u4F60\u7684\u60F3\u6CD5\u4E86\u3002"
    en: You do not need to explain anything to me, Captain. I think I understand
      some of your thoughts now.
    cnHaveBranch: 0
