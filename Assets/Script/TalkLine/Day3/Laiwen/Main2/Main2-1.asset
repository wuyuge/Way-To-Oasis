  TxtLine:
  - ->c
  - "\u83B1\u6587\uFF1A\u961F\u957F\u4F60\u786E\u5B9E\u662F\u4E2A\u9AD8\u5C1A\u7684\u4EBA\u3002@{Laugh}"
  - "\u83B1\u6587\uFF1A\u5373\u4F7F\u73B0\u5728\u6211\u4EEC\u9A6C\u4E0A\u5C31\u8981\u4E00\u8D77\u6B7B\u5728\u8FD9\u91CC\uFF0C\u6211\u4E5F\u6CA1\u6709\u4EC0\u4E48\u6028\u8A00\u4E86\u3002"
  - "\u83B1\u6587\uFF1A\u5728\u77E5\u6653\u65E2\u5B9A\u7684\u7ED3\u5C40\u4EE5\u540E\uFF0C\u6211\u53CD\u800C\u6709\u95F2\u5FC3\u53BB\u6B23\u8D4F\u8FD9\u91CC\u7684\u666F\u8272\u4E86\u3002"
  - "\u83B1\u6587\uFF1A\u800C\u4E14\u4EE5\u6211\u7684\u7ECF\u9A8C\u6765\u8BF4\uFF0C\u4E00\u822C\u8FD9\u79CD\u65F6\u5019\u624D\u66F4\u5BB9\u6613\u51FA\u73B0\u5947\u8FF9\u3002"
  - "\u83B1\u6587\uFF1A\u5C31\u50CF\u627E\u4E1C\u897F\u4E00\u6837\uFF0C\u4F60\u8D8A\u52AA\u529B\u53CD\u800C\u4F1A\u4E00\u65E0\u6240\u83B7\uFF0C\u800C\u653E\u5F03\u7684\u65F6\u5019\u5374\u4F1A\u6709\u65B0\u7684\u6536\u83B7\u3002"
  - "\u83B1\u6587\uFF1A\u2026\u2026"
  - "\u83B1\u6587\uFF1A\u5BF9\u4E86\uFF0C\u6211\u6253\u7B97\u5728\u901A\u8BAF\u5668\u4E0A\u628A\u8FD9\u51E0\u5929\u7684\u4E8B\u8BB0\u4E0B\u6765\uFF0C\u987A\u4FBF\u7ED9\u81EA\u5DF1\u5199\u4E00\u4EFD\u5893\u5FD7\u94ED\u3002"
  - "\u83B1\u6587\uFF1A\u867D\u7136\u73B0\u5728\u6CA1\u6709\u4FE1\u53F7\uFF0C\u4E07\u4E00\u4EE5\u540E\u522B\u7684\u63A2\u6D4B\u961F\u641C\u6551\u961F\u8DEF\u8FC7\u8FD9\u91CC\uFF0C\u8FD8\u80FD\u8BA9\u8FD9\u4E8B\u91CD\u89C1\u5929\u65E5\u3002"
  - "\u83B1\u6587\uFF1A\u8BF4\u4E0D\u5B9A\u5927\u5BB6\u90FD\u4F1A\u88AB\u6211\u4EEC\u575A\u5B88\u4EBA\u6027\u5E95\u7EBF\u7684\u505A\u6CD5\u6240\u611F\u52A8\u3002"
