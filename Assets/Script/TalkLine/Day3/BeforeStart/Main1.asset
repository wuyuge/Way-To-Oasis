  - "\u867D\u7136\u7ECF\u5386\u4E86\u6628\u5929\u7684\u4E8B\uFF0C\u4F60\u4F9D\u65E7\u8FCE\u6765\u4E86\u65B0\u7684\u65E9\u6668\u3002"
  - "\u8352\u829C\u7684\u571F\u5730\uFF0C\u9634\u6C89\u7684\u5929\u6C14\uFF0C\u4EE5\u53CA\u2026\u2026\u4E00\u9635\u9690\u7EA6\u7684\u4E89\u5435\u58F0\u3002"
  - /TalkLock
  - showcharabar
  - c
  - "\u535A\u91D1\u68EE\uFF1A\u8FD9\u662F\u5979\u81EA\u5DF1\u7684\u9009\u62E9\uFF0C\u602A\u4E0D\u4E86\u4EFB\u4F55\u4EBA\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u4EC0\u4E48\uFF1F"
  - "\u535A\u91D1\u68EE\uFF1A\u963F\u66FC\u5FB7\u7ED9\u81EA\u5DF1\u6CE8\u5C04\u4E86\u6BD2\u836F\uFF0C\u8FD9\u53E5\u8BDD\u5F88\u96BE\u7406\u89E3\u5417\uFF1F"
  - "\u827E\u7C73\u8389\uFF1A\u5979\u7528\u4E86\u968F\u8EAB\u643A\u5E26\u7684\u6700\u540E\u4E00\u4EFD\u6BD2\u7D20\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u662F\u56E0\u4E3A\u6628\u5929\u7684\u4E8B\uFF0C\u5979\u63A5\u53D7\u4E0D\u4E86\u73B0\u5B9E\uFF0C\u6216\u8005\u8BF4\u6709\u4EBA\u548C\u5979\u8BF4\u4E86\u4EC0\u4E48\u3002"
  - "\u83B1\u6587\uFF1A\u6211\u6CA1\u60F3\u5230\u5979\u4F1A\u4EE5\u8FD9\u79CD\u65B9\u5F0F\u79BB\u5F00\u3002{Calm}"
  - "\u83B1\u6587\uFF1A\u8FD9\u4EF6\u4E8B\u4E00\u5B9A\u6709\u5176\u5B83\u539F\u56E0\uFF0C\u4F46\u662F\u6211\u4EEC\u6CA1\u65F6\u95F4\u8FFD\u7A76\u4E86\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u963F\u66FC\u5FB7\u81EA\u6740\u4E86\uFF0C\u800C\u6211\u4EEC\u90FD\u4E0D\u80FD\u77E5\u9053\u4E3A\u4EC0\u4E48\uFF1F"
  - "\u535A\u91D1\u68EE\uFF1A\u5C0F\u5B50\uFF0C\u4F60\u4EE5\u4E3A\u5728\u5728\u54EA\u91CC\uFF1F\u4E0D\u5982\u6211\u4EEC\u73B0\u5728\u4E0A\u62A5\u6CBB\u5B89\u5B98\uFF0C\u7B49\u4E2A\u4E09\u5341\u5929\u5BA1\u6279\u6D41\u7A0B\u7136\u540E\u8C03\u67E5\u6E05\u695A\u3002"
  - "\u6D1B\u5C14\u574E\uFF1A\u6211\u4E0D\u662F\u8FD9\u4E2A\u610F\u601D\uFF01\u4F46\u5979\u662F\u6211\u4EEC\u7684\u540C\u4F34\uFF0C\u4E0D\u7BA1\u662F\u4E3A\u4E86\u963F\u66FC\u5FB7\u8FD8\u662F\u63A5\u4E0B\u6765\u961F\u4F0D\u7684\u5B89\u5168\uFF0C\u6211\u4EEC\u90FD\u5E94\u8BE5\u627E\u5230\u771F\u76F8\u3002"
  - "\u827E\u7C73\u8389\uFF1A\u90A3\u4F60\u5C31\u81EA\u5DF1\u53BB\u52AA\u529B\u5427\uFF0C\u6211\u4EEC\u6CA1\u6709\u5DE5\u592B\u505A\u8FD9\u4E9B\u4E8B\u3002"
  - "\u83B1\u6587\uFF1A\u4F46\u6D1B\u5C14\u574E\u8BF4\u7684\u4E0D\u65E0\u9053\u7406\uFF0C\u4E0D\u7BA1\u662F\u56E0\u4E3A\u4EC0\u4E48\uFF0C\u6211\u4EEC\u4E0D\u80FD\u518D\u653E\u4EFB\u4EFB\u4F55\u4E0D\u7A33\u5B9A\u56E0\u7D20\u3002"
  - "\u535A\u91D1\u68EE\uFF1A\u6211\u53EA\u5728\u4E4E\u600E\u4E48\u591A\u6D3B\u4E00\u5929\uFF0C\u800C\u4E0D\u662F\u6D6A\u8D39\u65F6\u95F4\u3002"
  - /showname
  - p
  - "\u2026\u2026"
  - "\u5230\u6B64\u4E3A\u6B62\u5427\u3002"
  - "\u8FD9\u4EF6\u4E8B\u6211\u4F1A\u5904\u7406\u7684\u3002\u65E0\u8BBA\u4F60\u4EEC\u60F3\u5E72\u4EC0\u4E48\uFF0C\u5728\u8FD9\u91CC\u4E89\u5435\u6CA1\u6709\u4EFB\u4F55\u7528\u3002"
  - c
  - "\u6D1B\u5C14\u574E\uFF1A\u53EF\u662F\u2026\u2026"
  - "\u83B1\u6587\uFF1A\u54CE\u5440\u6D1B\u5C14\u574E\uFF0C\u65E2\u7136\u961F\u957F\u5DF2\u7ECF\u8FD9\u4E48\u8BF4\u4E86\u5C31\u653E\u5FC3\u4EA4\u7ED9ta\u5427\u3002{Laugh}"
