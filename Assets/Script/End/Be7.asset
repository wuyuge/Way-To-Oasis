    audioEffect: 0
  - cn: "\u7ED3\u679C\u51FA\u4E4E\u610F\u6599\u7684\u795E\u5947\u3002"
    en: The result was strangely miraculous.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
    speaker: 0
    expression: 0
    showCg: 0
