    audioEffect: 0
  - cn: "\u6CA1\u6709\u4EBA\u613F\u610F\u5728\u6CE8\u5B9A\u7EDD\u671B\u7684\u4E16\u754C\u4E2D\u91CD\u590D\u5F98\u5F8A\u3002"
    en: No one wants to keep wandering in a world doomed to despair.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
