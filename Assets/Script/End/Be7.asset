    uncomfortType: 0
    audioEffect: 0
  - cn: "\u5982\u679C\u8FDE\u4F60\u90FD\u653E\u5F03\u4E86\u7684\u8BDD\u2026\u2026"
    en: If even you have given up...
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
