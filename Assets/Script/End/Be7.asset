  TxtLine: []
  data:
  - cn: "\u4E0D\u77E5\u51FA\u4E8E\u4EC0\u4E48\u60F3\u6CD5\uFF0C\u4F60\u9009\u62E9\u4E86\u8FD9\u6837\u4E00\u79CD\u5904\u7406\u65B9\u5F0F\u3002"
    en: For reasons only you know, you chose to handle things in this way.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
