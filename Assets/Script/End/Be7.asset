    uncomfortType: 0
    audioEffect: 0
  - cn: "\u6240\u6709\u4EBA\u7A81\u7136\u610F\u8BC6\u5230\u4F60\u63D0\u51FA\u7684\u5EFA\u8BAE\u6216\u8BB8\u662F\u8DDD\u79BB\u89E3\u8131\u6700\u8FD1\u7684\u8DEF\u5F84\u3002"
    en: Everyone suddenly realized that the proposal you made might be the path closest
      to release.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
