  m_Name: Start
  m_EditorClassIdentifier: 
  TxtLine:
  - "\u6211\u5C31\u77E5\u9053\u961F\u957F\u4F60\u662F\u5982\u6B64\u7684\u70ED\u5FC3\u4E14\u5584\u826F\uFF0C\u80AF\u5B9A\u613F\u610F\u5E2E\u52A9\u6211\u5B8C\u6210\u4E9B\u5FAE\u4E0D\u8DB3\u9053\u7684\u5C0F\u5DE5\u4F5C\u3002"
  - "\u7B80\u5355\u6765\u8BF4\uFF0C\u53EA\u8981\u628A\u8FD9\u4E9B\u4E1C\u897F\u6574\u9F50\u5730\u653E\u8FDB\u7BB1\u5B50\u91CC\u5C31\u53EF\u4EE5\u4E86\u3002"
  - "\u4E0D\u540C\u7269\u4F53\u7684\u6240\u5360\u7684\u9762\u79EF\u4E0D\u4E00\u6837\uFF0C\u867D\u7136\u5982\u6B64\u8FD9\u4E2A\u7BB1\u5B50\u653E\u4E0B\u8FD9\u4E9B\u4E1C\u897F\u4E5F\u662F\u7EF0\u7EF0\u6709\u4F59\u3002"
  - "\u8981\u6CE8\u610F\uFF0C\u4E0D\u80FD\u628A\u5B83\u4EEC\u53E0\u5728\u4E00\u8D77\u653E\u7F6E\u3002\u4E0D\u7136\u5F88\u5BB9\u6613\u4F1A\u641E\u574F\u4E00\u4E9B\u8106\u5F31\u7684\u4E1C\u897F\u3002"
  - "\u8FD9\u4E5F\u7B97\u662F\u5DE5\u4F5C\u5417\uFF1F\u54C8\u54C8\uFF0C\u53CD\u6B63\u73B0\u5728\u4E5F\u6CA1\u6709\u522B\u7684\u4E8B\u60C5\u53EF\u4EE5\u5E72\uFF0C\u505A\u4E9B\u6536\u7EB3\u5C31\u5F53\u662F\u7F13\u89E3\u538B\u529B\u4E86\u3002"
  data:
  - cn: "\u6211\u5C31\u77E5\u9053\u961F\u957F\u4F60\u662F\u5982\u6B64\u7684\u70ED\u5FC3\u4E14\u5584\u826F\uFF0C\u80AF\u5B9A\u613F\u610F\u5E2E\u52A9\u6211\u5B8C\u6210\u4E9B\u5FAE\u4E0D\u8DB3\u9053\u7684\u5C0F\u5DE5\u4F5C\u3002"
