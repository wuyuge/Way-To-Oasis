  TxtLine:
  - "\u4ECA\u5929\u5C31\u5230\u8FD9\u91CC\u5427\uFF0C\u8F9B\u82E6\u4E86\u3002"
  - "\u539F\u672C\u6211\u8FD8\u62C5\u5FC3\u4F60\u80FD\u4E0D\u80FD\u575A\u6301\u4E0B\u6765\uFF0C\u6BD5\u7ADF\u8FD9\u662F\u4E2A\u65E0\u804A\u7684\u53EA\u4F1A\u7ED9\u4EBA\u5E26\u6765\u5931\u671B\u7684\u5DE5\u4F5C\u3002"
  - "\u4F46\u4E0D\u5F97\u4E0D\u8BF4\uFF0C\u6709\u4F60\u5E2E\u5FD9\u4ECA\u5929\u5DE5\u4F5C\u82B1\u8D39\u7684\u65F6\u95F4\u8282\u7701\u4E86\u4E00\u534A\u3002"
  - "\u4E4B\u540E\u6709\u4EC0\u4E48\u9700\u8981\u968F\u65F6\u53EB\u6211\uFF0C\u8C22\u4E86\u3002"
  data:
  - cn: "\u4ECA\u5929\u5C31\u5230\u8FD9\u91CC\u5427\uFF0C\u8F9B\u82E6\u4E86\u3002"
    en: That is all for today. Thank you for your hard work.
