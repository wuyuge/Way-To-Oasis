  - cn: "\u8BDD\u867D\u8FD9\u4E48\u8BF4\uFF0C\u4F46\u4F60\u8981\u662F\u7559\u5728\u8FD9\u7ED9\u6211\u627E\u9EBB\u70E6\u7684\u8BDD\uFF0C\u8FD8\u4E0D\u5982\u53BB\u4E00\u8FB9\u5446\u7740\u3002"
    en: That said, if you stay here and cause trouble for me, you might as well stand
      aside.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
    isAside: 0
    codes: 
    onlyCode: 0
