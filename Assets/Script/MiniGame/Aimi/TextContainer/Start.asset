    audioEffect: 0
  - cn: "\u5177\u4F53\u600E\u4E48\u64CD\u4F5C\u6211\u53EA\u8BB2\u89E3\u4E00\u904D\uFF0C\u73B0\u5728\u4E0D\u60F3\u5E2E\u5FD9\u4E86\u8FD8\u6709\u53CD\u6094\u7684\u673A\u4F1A\u3002"
    en: I will explain the operation only once. If you do not want to help anymore,
      you still have the chance to change your mind.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
