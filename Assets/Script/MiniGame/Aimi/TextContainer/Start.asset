    minigameType: 0
    uncomfortType: 0
    audioEffect: 0
  - cn: "\u5C4F\u5E55\u4E0A\u7684\u7EFF\u8272\u5C0F\u70B9\u4EE3\u8868\u4E86\u6211\u4EEC\uFF0C\u800C\u7EA2\u8272\u5C0F\u70B9\u5219\u662F\u9700\u8981\u67E5\u770B\u7684\u4FE1\u53F7\u3002"
    en: The green dots on the screen represent us, and the red ones are signals we
      need to check.
    cnHaveBranch: 0
    cnBranch: []
    enHaveBranch: 0
    enBranch: []
    isPlayerTalking: 0
