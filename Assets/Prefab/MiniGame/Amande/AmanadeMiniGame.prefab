    - target: {fileID: 3861756542349734549, guid: 198047a18649756448e6f31eea9c3c36, type: 3}
      propertyPath: cn
      value: "  \u963F\u5C14\u6770\u519C\xB7\u6000\u7279\u535A\u58EB\u5728\u4EFF\u751F\u8840\u7BA1\u9540\u5C42\u9879\u76EE\u7684\u7B2C12\u6B21\u5931\u8D25\u540E\u56E0\u5FC3\u529B\u4EA4\u731D\u800C\u53BB\u4E16\u3002\u5728\u4ED6\u7684\u52A9\u624B\u6574\u7406\u6B8B\u7559\u7684\u5B9E\u9A8C\u6570\u636E\u65F6\uFF0C\u610F\u5916\u53D1\u73B0\u4E86\u526F\u4EA7\u7269\u5728\u5DE5\u4E1A\u4E0A\u7684\u5F3A\u9ECF\u5408\u6027\u3002\u4E3A\u7EAA\u5FF5\u8FD9\u4E00\u6545\u4E8B\uFF0C\u8BE5\u7269\u8D28\u6700\u7EC8\u88AB\u547D\u540D\u4E3A\u526F\u4EA7\u7269B-12\uFF0C\u5E76\u5E7F\u6CDB\u8FD0\u7528\u4E8E\u5404\u7C7B\u9700\u6C42\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 3861756542349734549, guid: 198047a18649756448e6f31eea9c3c36, type: 3}
      propertyPath: en
      value: '<B>Byproduct B-12: </B>Dr. Algernon White died of physical and mental
        exhaustion after the twelfth failure of the bionic blood-vessel coating project.
        When his assistant was organizing the remaining experimental data, they accidentally
        discovered the byproduct''s strong industrial adhesiveness. To commemorate
        this story, the substance was finally named Byproduct B-12 and became widely
        used in all kinds of applications.'
      objectReference: {fileID: 0}
