      propertyPath: cn
      value: "    \u4E00\u79CD\u7EA2\u8910\u8272\u7684\u7C89\u672B\u72B6\u7269\u8D28\uFF0C\u7531\u4E8E\u5176\u672C\u8EAB\u7A33\u5B9A\u7684\u5206\u5B50\u7ED3\u6784\u5728\u7EDD\u5927\u591A\u6570\u751F\u5316\u53CD\u5E94\u4E2D\u8868\u73B0\u51FA\u4EE4\u4EBA\u5931\u671B\u7684\u60F0\u6027\u3002\u7814\u7A76\u5458\u4EEC\u901A\u5E38\u4F1A\u4F7F\u7528\u8FD9\u79CD\u6750\u6599\u4F5C\u4E3A\u4E00\u4E9B\u50AC\u5316\u5242\u7684\u8F7D\u4F53\uFF0C\u6216\u7A00\u91CA\u4E00\u4E9B\u8FC7\u4E8E\u6D3B\u6CFC\u7684\u7269\u8D28\u3002\u5728\u4E00\u4E9B\u7279\u6B8A\u53CD\u5E94\u4E2D\uFF0C\u8FD9\u79CD\u6750\u6599\u4F1A\u4EA7\u751F\u4E00\u5B9A\u7A0B\u5EA6\u7684\u6291\u5236\u6548\u679C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 3861756542349734549, guid: 198047a18649756448e6f31eea9c3c36, type: 3}
      propertyPath: en
      value: '<B>Inert powder: </B>A reddish-brown powdered substance. Because of
        its stable molecular structure, it shows disappointing inertness in most
        biochemical reactions. Researchers usually use this material as a carrier
        for some catalysts, or to dilute substances that are too reactive. In some
        special reactions, this material produces a certain degree of inhibition.'
      objectReference: {fileID: 0}
